// Общий модуль / код внешней обработки для проверки в тестовой 1С 8.3.
// Только чтение JSON. Запись справочников, документов и проведение отсутствуют.
// Модуль требует проверки на конкретном релизе платформы и конфигурации.
Функция ПроверитьПакетSultanTrade(ПутьКФайлу) Экспорт
    Читатель = Новый ЧтениеJSON;
    Попытка
        Читатель.ОткрытьФайл(ПутьКФайлу, КодировкаТекста.UTF8);
        Пакет = ПрочитатьJSON(Читатель);
        Читатель.Закрыть();
    Исключение
        Читатель.Закрыть();
        ВызватьИсключение "Не удалось прочитать JSON-пакет Sultan Trade.";
    КонецПопытки;
    Если ТипЗнч(Пакет) <> Тип("Структура") Тогда
        ВызватьИсключение "Ожидалась структура пакета.";
    КонецЕсли;
    Схема = Неопределено;
    Если НЕ Пакет.Свойство("schema", Схема) Или Схема <> "sultan-trade.onec-preparation.v1" Тогда
        ВызватьИсключение "Неподдерживаемая схема пакета.";
    КонецЕсли;
    Режим = Неопределено;
    Если НЕ Пакет.Свойство("mode", Режим) Или Режим <> "preparation_only" Тогда
        ВызватьИсключение "Разрешён только режим подготовки.";
    КонецЕсли;
    Проведение = Неопределено;
    Если НЕ Пакет.Свойство("postingAllowed", Проведение) Или Проведение <> Ложь Тогда
        ВызватьИсключение "Пакет не должен разрешать проведение.";
    КонецЕсли;
    Строки = Неопределено;
    Если НЕ Пакет.Свойство("items", Строки) Или ТипЗнч(Строки) <> Тип("Массив") Тогда
        ВызватьИсключение "Нет массива строк пакета.";
    КонецЕсли;
    Если Строки.Количество() > 200 Тогда
        ВызватьИсключение "Превышен размер пакета.";
    КонецЕсли;
    Ключи = Новый Соответствие;
    Для Каждого СтрокаПакета Из Строки Цикл
        Если ТипЗнч(СтрокаПакета) <> Тип("Структура") Тогда
            ВызватьИсключение "Некорректная строка.";
        КонецЕсли;
        Ключ = Неопределено;
        Если НЕ СтрокаПакета.Свойство("externalKey", Ключ) Или ТипЗнч(Ключ) <> Тип("Строка") Тогда
            ВызватьИсключение "Нет внешнего ключа строки.";
        КонецЕсли;
        Если ПустаяСтрока(Ключ) Или Ключи.Получить(Ключ) <> Неопределено Тогда
            ВызватьИсключение "Пустой или повторный внешний ключ.";
        КонецЕсли;
        Ключи.Вставить(Ключ, Истина);
    КонецЦикла;
    Возврат Новый Структура("Режим,Количество,Проведение", "ТолькоПроверка", Строки.Количество(), Ложь);
КонецФункции
