
# ── Tender Intelligence ──
# Почты (через запятую), которым открыт раздел /tenders. Пусто = раздел закрыт для всех.
TENDERS_ALLOWED_EMAILS=
# Потолок числа лотов в базе для MVP (бережём Supabase Disk IO)
TENDERS_MAX_ROWS=5000
# Токен официального API госзакупок. Задавать только после подтверждения доступа оператором; без него источник отключён.
GOSZAKUP_API_TOKEN=

# 1С: только чтение структуры тестовой публикации OData. По умолчанию выключено.
ONEC_READONLY_ENABLED=false
ONEC_ENVIRONMENT=test
ONEC_ODATA_URL=
ONEC_ALLOWED_HOST=
ONEC_USERNAME=
ONEC_PASSWORD=

# WhatsApp: подготовка архитектуры. Подключение и отправка пока выключены.
WHATSAPP_MODE=prepared
WHATSAPP_SEND_ENABLED=false
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_WABA_ID=
WHATSAPP_GRAPH_VERSION=
WHATSAPP_ACCESS_TOKEN=
